<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/chipRow" android:layout_width="wrap_content" android:layout_height="40dp"
        android:layout_marginTop="6dp" android:background="@drawable/bg_pill"
        android:gravity="center_vertical" android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/btnFlash" style="@style/Chip" android:text="⚡ OFF" />
        <TextView android:id="@+id/chipHdr" style="@style/Chip" android:text="HDR" />
        <TextView android:id="@+id/chipTimer" style="@style/Chip" android:text="⏱ OFF" />
        <TextView android:id="@+id/chipGrid" style="@style/Chip" android:text="GRID" />
        <TextView android:id="@+id/chipLook" style="@style/Chip" android:text="Natural" />
    </LinearLayout>

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="H,3:4"
        app:layout_constraintTop_toBottomOf="@id/chipRow"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <com.portraitcam.GridOverlay
        android:id="@+id/grid" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />

    <TextView
        android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="3" android:textColor="#FFFFFF" android:textSize="96sp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />

    <LinearLayout
        android:id="@+id/zoomRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_pill" android:orientation="horizontal" android:padding="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />

    <LinearLayout
        android:id="@+id/panel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/zoomRow"
        app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView">
        <LinearLayout
            android:id="@+id/blurRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="12dp" android:visibility="gone">
            <TextView android:layout_width="58dp" android:layout_height="wrap_content"
                android:text="Blur" android:textColor="#FFFFFF" android:textSize="13sp" />
            <SeekBar android:id="@+id/seekBlur" android:layout_width="190dp" android:layout_height="wrap_content"
                android:max="100" android:progress="70" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/smoothRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="12dp">
            <TextView android:layout_width="58dp" android:layout_height="wrap_content"
                android:text="Smooth" android:textColor="#FFFFFF" android:textSize="13sp" />
            <SeekBar android:id="@+id/seekSmooth" android:layout_width="190dp" android:layout_height="wrap_content"
                android:max="100" android:progress="30" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modeRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvPhoto" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="12dp" android:text="PHOTO" android:textColor="#FFD54F" android:textSize="14sp" />
        <TextView android:id="@+id/tvPortrait" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="12dp" android:text="PORTRAIT" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <ImageView android:id="@+id/thumb" android:layout_width="54dp" android:layout_height="54dp"
        android:layout_marginStart="44dp" android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <View android:id="@+id/shutter" android:layout_width="78dp" android:layout_height="78dp"
        android:background="@drawable/shutter" android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <TextView android:id="@+id/btnFlip" android:layout_width="54dp" android:layout_height="54dp"
        android:layout_marginEnd="44dp" android:layout_marginBottom="36dp"
        android:gravity="center" android:text="⟲" android:textColor="#FFFFFF" android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
